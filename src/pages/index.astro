---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contributions from '../components/Contributions.astro';
import { personJsonLd } from '../lib/seo';
import { formatDate } from '../lib/date';
import { getStats } from '../lib/stats';
import { patches, pending, LORE, commitUrl } from '../lib/patches';
import { jobs, work, isCurrent, yearsInSoftware } from '../lib/work';
import { summary, asusctl as asusctlInfo, ogc, education, hasTags } from '../lib/cv';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const { repoCount, kernelPatches, asusctlRelease, asusctlStars } = await getStats();
const years = yearsInSoftware();
const profile = summary(kernelPatches);
const asusctl = asusctlInfo(asusctlStars);

const tech = [
  'Rust', 'C', 'TypeScript', 'Go', 'PHP · Laravel', 'Python', 'Linux', 'PostgreSQL', 'Docker',
];
// Each marquee group must be wider than the widest viewport or a blank gap
// scrolls in at the -50% loop point. Repeat the lane so it always overflows.
const lane = [...tech, ...tech, ...tech];
---
<Base jsonLd={personJsonLd()} home>
  <!-- HERO -->
  <section id="top" class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="badge"><span class="live"></span>{kernelPatches} PATCHES IN THE MAINLINE LINUX KERNEL</div>
        <h1>I'm <span class="accent">Yaseen</span>,<br />a software engineer.</h1>
        <p class="lead">{profile.map((r) => (r.b ? <strong>{r.t}</strong> : r.t))}</p>
        <div class="hero-cta">
          <a href="#work" class="btn btn-primary">See the work →</a>
          <a href="mailto:yaseen@ghoul.dev" class="btn btn-ghost">Get in touch</a>
          <a href="/resume" class="btn btn-ghost">Résumé</a>
        </div>
        <div class="hero-meta">
          <span>Malé, Maldives</span>
          <span class="sep"></span>
          <span>UTC+5</span>
          <span class="sep"></span>
          <span class="em">yaseen@ghoul.dev</span>
        </div>
      </div>

      <div class="hero-term">
        <div class="term">
          <div class="term-bar">
            <span class="tdot"></span><span class="tdot"></span><span class="tdot on"></span>
            <span class="ttitle">~/linux · master</span>
          </div>
          <div class="term-body">
            <div><span class="path">$</span> git log --oneline --author=yaseen@ghoul.dev</div>
            <ul class="term-log">
              {patches.map((p) => (
                <li><a class="prompt" href={commitUrl(p)} target="_blank" rel="noopener">{p.sha}</a><span>{p.subject}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECH MARQUEE -->
  <div class="marquee">
    <div class="marquee-track">
      <div class="marquee-group">
        {lane.map((t) => (<><span>{t}</span><span class="slash">/</span></>))}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {lane.map((t) => (<><span>{t}</span><span class="slash">/</span></>))}
      </div>
    </div>
  </div>

  <!-- WORK -->
  <section id="work" class="section" style="padding-top:92px;">
    <div class="section-head">
      <span class="idx">01 / work</span>
      <h2>Projects</h2>
    </div>

    <div class="feature">
      <div class="feature-grid">
        <div class="feature-main">
          <div class="feature-eyebrow">
            <span class="lang lang-kernel"></span>
            <span>Linux kernel · platform/x86</span>
            <span class="flag">IN MAINLINE</span>
          </div>
          <h3>Upstream Linux kernel</h3>
          <p>C for the kernel's ASUS laptop drivers and USB HID.</p>
        </div>
      </div>
      <ul class="patches">
        {patches.map((p) => (
          <li>
            <a class="sha" href={commitUrl(p)} target="_blank" rel="noopener">{p.sha}<span class="visually-hidden"> (opens in a new tab)</span></a>
            <span><b>{p.area}</b> {p.text}</span>
          </li>
        ))}
        {pending.map((p) => (
          <li class="pending">
            <a class="sha" href={LORE} target="_blank" rel="noopener">on list<span class="visually-hidden"> (opens in a new tab)</span></a>
            <span><b>{p.area}</b> {p.text}</span>
          </li>
        ))}
      </ul>
      <div class="tags"><span class="tag">C</span><span class="tag">Linux kernel</span><span class="tag">platform/x86</span><span class="tag">HID</span></div>
      <div class="kernel-links mono">
        <a href={LORE} target="_blank" rel="noopener">all patches on lore <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      </div>
    </div>

    <div class="subhead">Personal &amp; open-source projects</div>
    <div class="proj-grid">
      <a href="https://github.com/OpenGamingCollective/asusctl" target="_blank" rel="noopener" class="proj">
        <div class="proj-eyebrow"><span class="lang lang-rust"></span><span class="lbl">Rust · ASUS Linux · maintainer</span></div>
        <h4>asusctl</h4>
        <p>{asusctl.text}</p>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      <a href="https://github.com/OpenGamingCollective" target="_blank" rel="noopener" class="proj">
        <div class="proj-eyebrow"><span class="lang lang-kernel"></span><span class="lbl">Community · infrastructure</span></div>
        <h4>Open Gaming Collective</h4>
        <p>{ogc.role}. {ogc.text}</p>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </div>
    <div class="also">
      <span class="lbl">also contributing at</span>
      <span class="chip">asus-linux</span>
      <span class="chip">caelestia-dots</span>
      <a href="https://github.com/Ghoul4500" target="_blank" rel="noopener" class="accent mono" style="font-size:12px;margin-left:4px;">github.com/Ghoul4500 <span aria-hidden="true">→</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </section>

  <!-- CLIENTS -->
  <section id="clients" class="section">
    <div class="section-head">
      <span class="idx">02 / clients</span>
      <h2>Who I've built for</h2>
    </div>
    <p class="lead-text">
      Government and UN platforms, and consumer apps used across the Maldives, mostly through
      OXIQA and Synetecs. On most of them I am the lead or the only engineer.
    </p>
    <div class="card-grid">
      {work.map((w) => (
        <div class="card">
          <div class="card-head"><h3>{w.name}</h3><span class="pill">{w.pill}</span></div>
          <div class="sub">{w.sub}</div>
          <div class="meta">{w.via ? w.meta.replace(' · ', ` · via ${w.via} · `) : w.meta}</div>
          <p>{w.text}</p>
          <div class="tags">{w.tags.map((t) => <span class="tag">{t}</span>)}</div>
          {w.link && <a href={w.link.href} target="_blank" rel="noopener" class="proof mono">{w.link.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>}
        </div>
      ))}
    </div>
    <div class="also">
      <span class="lbl">also:</span>
      <span class="chip">thaana.ai · Dhivehi language models</span>
      <span class="chip">legalnotes · AI for legal</span>
      <span class="chip">Ministry of Dhivehi Language · Dhiraasa</span>
      <span class="chip">iqdot · SentinelOne / EDR</span>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section">
    <div class="section-head">
      <span class="idx">03 / experience</span>
      <h2>Where I've worked</h2>
    </div>
    <div class="timeline">
      {jobs.filter(isCurrent).map((j) => (
        <div class="tl-item"><span class="node"></span>
          <div class="tl-period">{j.when}</div>
          <div class="tl-body"><h3>{j.org}</h3><div class="tl-role">{j.role}</div>
            {j.points.map((p) => <p>{p}</p>)}</div>
        </div>
      ))}
      <div class="tl-item"><span class="node"></span>
        <div class="tl-period">2026 – Present</div>
        <div class="tl-body"><h3>Linux upstream · asus-linux · OGC</h3><div class="tl-role">Kernel Contributor · asusctl Maintainer · OGC Community Manager</div>
          <p>{kernelPatches} patches merged in the mainline kernel, in USB HID and the ASUS platform/x86 drivers, most backported to stable. I maintain asusctl, and run the Open Gaming Collective's GitHub organisation, governance bot and community.</p></div>
      </div>
      {jobs.filter((j) => !isCurrent(j)).map((j) => (
        <div class="tl-item past"><span class="node"></span>
          <div class="tl-period">{j.when}</div>
          <div class="tl-body"><h3>{j.org}</h3><div class="tl-role">{j.role}</div>
            {j.points.map((p) => <p>{p}</p>)}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ACTIVITY -->
  <section id="activity" class="section">
    <div class="section-head">
      <span class="idx">04 / activity</span>
      <h2>On GitHub</h2>
    </div>
    <div class="stat-grid">
      <div class="stat"><div class="n">{kernelPatches}</div><div class="l">patches in the mainline kernel</div></div>
      <div class="stat"><div class="n">{asusctlRelease}</div><div class="l">latest asusctl release · maintainer</div></div>
      <div class="stat"><div class="n">{repoCount}</div><div class="l">public repositories</div></div>
      <div class="stat"><div class="n">{years}+</div><div class="l">years building software</div></div>
    </div>
    <Contributions />
  </section>

  <!-- EDUCATION -->
  <section id="education" class="section">
    <div class="section-head">
      <span class="idx">05 / education</span>
      <h2>Education</h2>
    </div>
    <div class="edu-grid">
      {education.map((e) => (
        <div class="edu">
          <div class="when">{e.when}</div>
          <h3>{e.what}</h3>
          <div class={`where${hasTags(e) ? '' : ' last'}`}>{e.where}</div>
          {hasTags(e) && (
            <div class="tags">
              {e.result && <span class="award-fill">{e.result}</span>}
              {e.topAward && <span class="award-top">{e.topAward}</span>}
              {e.awards?.map((a) => <span class="award">{a}</span>)}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section id="blog" class="section">
    <div class="section-head">
      <span class="idx">06 / writing</span>
      <h2>Writing</h2>
    </div>
    <div class="blog-grid">
      {posts.slice(0, 3).map((p) => (
        <a href={`/blog/${p.id}/`} class="post-card">
          <div class="when">{formatDate(p.data.published)}</div>
          <h3>{p.data.cardTitle ?? p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="more">Read →</span>
        </a>
      ))}
    </div>
    {posts.length > 0 && (
      <div class="also" style="margin-top:22px;">
        <a href="/blog" class="accent mono" style="font-size:13px;">All posts →</a>
      </div>
    )}
  </section>

  {/* VENTURE — Zenryk. Hidden until zenryk.com is live. To re-enable: uncomment this whole
     section AND renumber the contact section below from "07 / contact" back to "08 / contact"
     (contact is numbered 07 while this venture section is hidden, so the sequence stays unbroken).
  <section class="section">
    <div class="venture">
      <div class="venture-main">
        <span class="idx mono accent" style="font-size:13px;">07 / venture</span>
        <h2><span class="accent">Zenryk</span>, my studio</h2>
        <p>My own company, registered in the Maldives. The way to hire me as a business rather than a freelancer. You work directly with me, and for bigger builds I bring in a small bench of trusted collaborators, so you get senior continuity with the capacity of a team.</p>
        <a href="mailto:info@zenryk.com">info@zenryk.com →</a>
      </div>
      <div class="venture-card">
        <div class="inner">
          <div class="name">zenryk<span class="accent">.com</span></div>
          <div class="soon"><span class="live"></span>LAUNCHING SOON</div>
        </div>
      </div>
    </div>
  </section>
  */}

  <!-- CONTACT -->
  <section id="contact" class="contact">
    <span class="idx mono accent" style="font-size:13px;">07 / contact</span>
    <h2>Get in touch</h2>
    <p>Email is the best way to reach me.</p>
    <div class="row">
      <a href="mailto:yaseen@ghoul.dev" class="btn btn-primary">yaseen@ghoul.dev</a>
      <a href="https://github.com/Ghoul4500" target="_blank" rel="noopener" class="btn btn-ghost">GitHub <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      <a href="https://gitlab.com/Ghoul4500" target="_blank" rel="noopener" class="btn btn-ghost">GitLab <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
    <div class="note mono">Based in Malé · UTC+5 · comfortable across US and EU hours</div>
  </section>
</Base>
