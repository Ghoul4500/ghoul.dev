---
// Two fixed A4 sheets, printed to the styled PDFs by `npm run resume`.
import Base from '../layouts/Base.astro';
import { getStats } from '../lib/stats';
import { RESUME_HREF, RESUME_HREF_LIGHT, RESUME_HREF_PLAIN } from '../lib/resume';
import { patches, pending, LORE, commitUrl } from '../lib/patches';
import { jobs, isCurrent } from '../lib/work';
import {
  NAME, HEADLINE, contact, summary, asusctl, ogc, skills, education, hasTags, awards,
} from '../lib/cv';

const { asusctlRelease, asusctlStars, kernelPatches } = await getStats();
const profile = summary(kernelPatches);
const oss = [asusctl(asusctlStars), ogc];
const [first, last] = NAME.split(' ');

const timeline = [jobs.filter(isCurrent), jobs.filter((j) => !isCurrent(j))];

const generated = new Date().toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base
  title="Résumé — Ahmed Yaseen (Ghoul) · ghoul.dev"
  description="Résumé of Ahmed Yaseen: Linux kernel contributor, asusctl maintainer and full-stack engineer in the Maldives. Download as PDF."
>
  <div class="resume-bar">
    <div>
      <div class="rb-title mono">~/resume</div>
      <div class="rb-sub">Two pages, A4. The PDFs are rendered from this page.</div>
    </div>
    <div class="rb-actions">
      <a href={RESUME_HREF_PLAIN} download="Ahmed-Yaseen-Resume.pdf" class="btn btn-ghost" title="Single column, plain text: reads cleanly in job portals and applicant tracking systems">Plain PDF for job portals</a>
      <a href={RESUME_HREF} data-light-href={RESUME_HREF_LIGHT} download="Ahmed-Yaseen-Resume.pdf" id="resume-dl" class="btn btn-primary">Download PDF <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <div class="sheets">
    <!-- ============================ SHEET 1 ============================ -->
    <article class="sheet">
      <header class="r-head">
        <div class="r-hero">
          <div>
            <h1>{first} <span class="accent">{last}</span></h1>
            <p class="r-role">{HEADLINE}</p>
          </div>
          <div class="r-term mono">
            <div class="bar"><i></i><i></i><i class="on"></i><span>git log --oneline · mainline</span></div>
            <div class="body">
              {patches.map((p) => (
                <div><span class="sha">{p.sha}</span> {p.area}</div>
              ))}
            </div>
          </div>
        </div>
        <div class="r-contact mono">
          {contact.map((c) => <a href={c.href}>{c.label}</a>)}
        </div>
        <div class="r-top mono">
          <span>GHOUL<b>.DEV</b> · MALÉ, MALDIVES · UTC+5</span>
          <span>RÉSUMÉ</span>
        </div>
      </header>

      <div class="r-main">
        <section>
          <h2><span class="idx mono">01 /</span> Summary</h2>
          <p class="r-lead">{profile.map((r) => (r.b ? <strong>{r.t}</strong> : r.t))}</p>
        </section>

        <section>
          <h2><span class="idx mono">02 /</span> Open source</h2>

          <div class="r-item">
            <div class="r-item-head">
              <h3>Linux kernel</h3>
              <span class="flag mono">IN MAINLINE</span>
              <span class="when mono">2026 – Present</span>
            </div>
            <div class="r-sub mono">Contributor · USB HID · platform/x86 drivers · C</div>
            <ul class="r-patches">
              {patches.map((p, i) => (
                <li>
                  <a class="sha mono" href={commitUrl(p)}>{p.sha}</a>
                  <span><b class="mono">{p.area}</b> {i === 0 ? p.text : (p.short ?? p.text)}</span>
                </li>
              ))}
              {pending.map((p) => (
                <li class="pending">
                  <a class="sha mono" href={LORE}>on list</a>
                  <span><b class="mono">{p.area}</b> {p.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="r-duo">
            {oss.map((o) => (
              <div class="r-item">
                <div class="r-item-head">
                  <h3>{o.name}</h3>
                  <span class="when mono">{o.when}</span>
                </div>
                <div class="r-sub mono">{o.role} · {o.name === 'asusctl' ? `${o.sub} · v${asusctlRelease}` : o.sub}</div>
                <p>{o.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2><span class="idx mono">03 /</span> Experience</h2>
          <div class="r-timeline">
            {timeline[0].map((j) => (
              <div class="r-job">
                <div class="when mono">{j.when}</div>
                <div class="body">
                  <h3>{j.org}</h3>
                  <div class="r-sub mono">{j.role}</div>
                  <ul>{j.points.map((p) => <li>{p}</li>)}</ul>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>

      <footer class="r-foot mono"><span>ghoul.dev/resume</span><span>{generated}</span><span>1 / 2</span></footer>
    </article>

    <!-- ============================ SHEET 2 ============================ -->
    <article class="sheet">
      <div class="r-top2 mono">
        <span>AHMED <b>YASEEN</b> · RÉSUMÉ</span>
        <span>yaseen@ghoul.dev</span>
      </div>

      <section>
        <h2><span class="idx mono">03 /</span> Experience <span class="aside mono">continued</span></h2>
        <div class="r-timeline">
          {timeline[1].map((j) => (
            <div class="r-job">
              <div class="when mono">{j.when}</div>
              <div class="body">
                <h3>{j.org}</h3>
                <div class="r-sub mono">{j.role}</div>
                <ul>{j.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2><span class="idx mono">04 /</span> Skills</h2>
        <div class="r-skills">
          {skills.map((s) => (
            <div class="r-skill">
              <div class="k mono">{s.k}</div>
              <div class="v">{s.v.map((t) => <span class="tag">{t}</span>)}</div>
            </div>
          ))}
        </div>
      </section>

      <div class="r-pair">
        <section>
          <h2><span class="idx mono">05 /</span> Education</h2>
          {education.map((e) => (
            <div class="r-edu">
              <div class="when mono">{e.when}</div>
              <h3>{e.what}</h3>
              <div class="where">{e.where}</div>
              {hasTags(e) && (
                <div class="r-edu-tags">
                  {e.result && <span class="result mono">{e.result}</span>}
                  {e.topAward && <span class="top mono">{e.topAward}</span>}
                  {e.awards?.map((a) => <span class="award mono">{a}</span>)}
                </div>
              )}
            </div>
          ))}
        </section>

        <section>
          <h2><span class="idx mono">06 /</span> Awards</h2>
          <ul class="r-awards">
            {awards.map((a) => <li>{a}</li>)}
          </ul>
        </section>
      </div>

      <footer class="r-foot mono"><span>ghoul.dev/resume</span><span>{generated}</span><span>2 / 2</span></footer>
    </article>
  </div>

  <script is:inline>
    // Fit the fixed-width A4 sheets to narrow viewports.
    (function () {
      var fit = function () {
        var z = Math.min(1, (document.documentElement.clientWidth - 24) / 794);
        document.documentElement.style.setProperty('--rz', String(z));
      };
      fit();
      addEventListener('resize', fit);
    })();

    // Download the PDF in the theme the page is shown in (dark without JS).
    (function () {
      var dl = document.getElementById('resume-dl');
      if (!dl) return;
      var dark = dl.getAttribute('href');
      dl.addEventListener('click', function () {
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        dl.setAttribute('href', light ? dl.getAttribute('data-light-href') : dark);
      });
    })();
  </script>
</Base>

<style>
  .mono { font-family: var(--mono); }
  .accent { color: var(--accent); }

  /* ---- on-screen chrome ---- */
  .resume-bar {
    width: min(794px, calc(100% - 24px)); margin: 36px auto 18px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  }
  .rb-title { color: var(--accent); font-size: 14px; }
  .rb-sub { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .rb-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .sheets { display: flex; flex-direction: column; align-items: center; gap: 24px; padding: 0 12px 72px; }

  /* ---- the sheet: A4 at 96dpi ---- */
  .sheet {
    width: 794px; height: 1123px; flex: none; zoom: var(--rz, 1);
    position: relative; overflow: hidden;
    padding: 40px 44px 46px;
    background: var(--bg);
    border: 1px solid var(--border); border-radius: 10px;
    color: var(--fg); font-size: 11px; line-height: 1.5;
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / .6);
  }
  .sheet a { color: inherit; }
  .sheet p { margin: 0; }
  .sheet ul { margin: 0; padding: 0; list-style: none; }
  .sheet h1, .sheet h2, .sheet h3 { margin: 0; }
  .sheet section + section { margin-top: 16px; }

  /* ---- header ---- */
  .r-top, .r-top2 { display: flex; align-items: center; justify-content: space-between; font-size: 9.5px; letter-spacing: .12em; color: var(--muted); }
  .r-top b, .r-top2 b { color: var(--accent); font-weight: 500; }
  .r-top { position: absolute; top: 40px; left: 44px; right: 44px; }
  .r-hero { display: grid; grid-template-columns: 1fr 224px; gap: 26px; align-items: end; margin-top: 22px; }
  .r-head h1 { font-size: 56px; line-height: 1; letter-spacing: -0.04em; margin-top: 4px; }
  .r-role { font-size: 14px; color: var(--muted); font-weight: 500; margin-top: 10px !important; }
  .r-contact { display: flex; flex-wrap: wrap; gap: 6px 8px; margin-top: 14px; font-size: 9.5px; }
  .r-contact a { padding: 4px 9px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
  .r-contact a:first-child { border-color: var(--accent); color: var(--accent); }

  /* ---- section heads ---- */
  .sheet h2 {
    display: flex; align-items: baseline; gap: 8px; font-size: 15px; letter-spacing: -0.01em;
    padding-bottom: 7px; margin-bottom: 11px; border-bottom: 1px solid var(--border);
  }
  .sheet h2 .idx { font-size: 9.5px; font-weight: 400; color: var(--accent); letter-spacing: 0; }
  .sheet h3 { font-size: 12.5px; letter-spacing: -0.01em; }

  /* ---- columns ---- */
  .r-main { margin-top: 14px; }
  .r-main > section + section { margin-top: 13px; }
  .r-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin-top: 13px; padding-top: 12px; border-top: 1px dashed var(--border); }
  .r-duo .r-item + .r-item { margin-top: 0; padding-top: 0; border-top: 0; }
  .r-pair { display: grid; grid-template-columns: 1.4fr 1fr; gap: 26px; margin-top: 16px; }
  .r-pair section + section { margin-top: 0; }
  .r-pair + section { margin-top: 16px; }
  .r-skills { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 26px; }
  .r-lead { font-size: 11.5px; line-height: 1.6; color: var(--muted); text-wrap: pretty; }
  .r-lead strong { color: var(--fg); font-weight: 600; }

  .r-item + .r-item { margin-top: 14px; padding-top: 13px; border-top: 1px dashed var(--border); }
  .r-item-head { display: flex; align-items: center; gap: 8px; }
  .r-item-head .when { margin-left: auto; font-size: 9px; color: var(--muted); }
  .r-item p { color: var(--muted); margin-top: 6px; text-wrap: pretty; }
  .flag { font-size: 8px; padding: 2px 6px; border-radius: 999px; background: var(--accent); color: var(--ink); font-weight: 700; letter-spacing: .04em; }
  .r-sub { font-size: 9px; color: var(--accent); margin-top: 2px; }

  .r-patches { margin-top: 9px !important; display: grid; gap: 7px; }
  .r-patches li { display: grid; grid-template-columns: 52px 1fr; gap: 10px; color: var(--muted); }
  .r-patches .sha {
    font-size: 9px; color: var(--accent); align-self: start; text-align: center;
    padding: 2px 0; border: 1px solid color-mix(in oklch, var(--accent) 40%, transparent); border-radius: 5px;
  }
  .r-patches b { font-size: 9.5px; font-weight: 500; color: var(--fg); margin-right: 3px; }
  .r-patches .pending .sha { color: var(--muted); border-color: var(--border); border-style: dashed; }

  /* ---- sidebar ---- */
  .r-term { border: 1px solid var(--border); border-radius: 10px; background: var(--surface); overflow: hidden; font-size: 9px; }
  .r-term .bar { display: flex; align-items: center; gap: 5px; padding: 7px 10px; border-bottom: 1px solid var(--border); color: var(--muted); }
  .r-term .bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--border); }
  .r-term .bar i.on { background: var(--accent); }
  .r-term .bar span { margin-left: 6px; }
  .r-term .body { padding: 9px 10px; line-height: 1.75; }
  .r-term .sha { color: var(--accent); }
  .r-term .dim { color: var(--muted); opacity: .75; }

  .r-skill .k { font-size: 8.5px; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; margin-bottom: 5px; }
  .r-skill .v { display: flex; flex-wrap: wrap; gap: 4px; }
  .sheet .tag { font-size: 8.5px; padding: 2px 6px; border-radius: 5px; }

  .r-edu + .r-edu { margin-top: 6px; }
  .r-edu .when { font-size: 8.5px; color: var(--accent); }
  .r-edu h3 { font-size: 11.5px; margin-top: 1px; }
  .r-edu .where { color: var(--muted); font-size: 10px; }
  .r-edu-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px; }
  .r-edu-tags > span { font-size: 8.5px; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--accent); }
  .r-edu .result { background: var(--accent); color: var(--ink); font-weight: 700; }
  .r-edu .top { color: var(--accent); }
  .r-edu .award { border-color: var(--border); color: var(--muted); }

  .r-awards { display: grid; gap: 5px; }
  .r-awards li { position: relative; padding-left: 13px; color: var(--muted); font-size: 10.5px; }
  .r-awards li::before { content: '▸'; position: absolute; left: 0; color: var(--accent); }

  /* ---- sheet 2 ---- */
  .r-top2 { margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
  .r-job { display: grid; grid-template-columns: 104px 1fr; gap: 14px; position: relative; padding-bottom: 6px; }
  .r-job:last-child { padding-bottom: 0; }
  .r-job .when { font-size: 9px; color: var(--muted); padding-top: 2px; }
  .r-job .body { position: relative; padding-left: 16px; border-left: 1px solid var(--border); }
  .r-job .body::before {
    content: ''; position: absolute; left: -4px; top: 5px; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 0 3px var(--bg);
  }
  .r-job ul { margin-top: 5px !important; display: grid; gap: 3px; }
  .r-job li { position: relative; padding-left: 12px; color: var(--muted); text-wrap: pretty; }
  .r-job li::before { content: '–'; position: absolute; left: 0; color: var(--border); }

  .sheet h2 .aside { margin-left: auto; font-size: 8.5px; font-weight: 400; color: var(--muted); letter-spacing: 0; }

  /* ---- footer ---- */
  .r-foot {
    position: absolute; left: 44px; right: 44px; bottom: 20px;
    display: flex; justify-content: space-between; font-size: 8px; color: var(--muted); letter-spacing: .08em;
    padding-top: 8px; border-top: 1px solid var(--border);
  }

  /* ---- print / PDF: bare sheets, edge to edge ---- */
  @page { size: A4; margin: 0; }
  @media print {
    :global(html), :global(body) { background: var(--bg) !important; }
    :global(body) { display: block; min-height: 0; }
    :global(.nav), :global(.foot), :global(.skip-link), .resume-bar { display: none !important; }
    :global(*) { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    .sheets { display: block; padding: 0; }
    .sheet {
      zoom: 1; width: 210mm; height: 297mm; border: 0; border-radius: 0; box-shadow: none;
      break-after: page; break-inside: avoid;
    }
    .sheet:last-child { break-after: auto; }
  }
</style>
